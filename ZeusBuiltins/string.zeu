using original;

// Generic value conversion and list-producing split keep the dynamic ABI.
@native("zeus_string_builtin_str")
decl func __builtin_str(value);

@native("zeus_string_builtin_type")
decl func type(value);

@native("zeus_string_builtin_len")
decl func len(value);

// Text-only operations cross the LLVM boundary as typed StringView values.
@native("zeus_string_length_view")
decl func __str_length(value: string) -> int;

@native("zeus_string_get_view")
decl func __str_get(value: string, index: int) -> string;

@native("zeus_string_slice_view")
decl func __str_slice(value: string, start: int, end: int) -> string;

@native("zeus_string_index_view")
decl func __str_index(value: string, substring: string) -> int;

@native("zeus_string_rindex_view")
decl func __str_rindex(value: string, substring: string) -> int;

@native("zeus_string_replace_view")
decl func __str_replace(value: string, old: string, replacement: string) -> string;

@native("zeus_string_split")
decl func __str_split(value, separator);

@native("zeus_string_startswith_view")
decl func __str_startswith(value: string, prefix: string) -> bool;

@native("zeus_string_endswith_view")
decl func __str_endswith(value: string, suffix: string) -> bool;

@native("zeus_string_lower_view")
decl func __str_lower(value: string) -> string;

@native("zeus_string_upper_view")
decl func __str_upper(value: string) -> string;

@native("zeus_string_count_view")
decl func __str_count(value: string, substring: string) -> int;

// String literals and all methods use the native `string` representation.
impl string {
    using &this;

    // new string(value) is a value factory; it does not allocate a class object.
    func operator[new](value = "") -> string {
        if (type(value) == "string") {
            return value;
        }
        return __builtin_str(value);
    }

    func length() -> int {
        return __str_length(this);
    }

    func toString() -> string {
        return this;
    }

    func nativeString() -> string {
        return this;
    }

    func isEmpty() -> bool {
        return __str_length(this) == 0;
    }

    func clone() -> string {
        return this;
    }

    func get(index: int) -> string {
        return __str_get(this, index);
    }

    func slice(start: int, end: int) -> string {
        return __str_slice(this, start, end);
    }

    func index(substring: string) -> int {
        return __str_index(this, substring);
    }

    func rindex(substring: string) -> int {
        return __str_rindex(this, substring);
    }

    func replace(old: string, replacement: string) -> string {
        return __str_replace(this, old, replacement);
    }

    func split(separator: string) {
        return __str_split(this, separator);
    }

    func startswith(prefix: string) -> bool {
        return __str_startswith(this, prefix);
    }

    func endswith(suffix: string) -> bool {
        return __str_endswith(this, suffix);
    }

    func lower() -> string {
        return __str_lower(this);
    }

    func upper() -> string {
        return __str_upper(this);
    }

    func count(substring: string) -> int {
        return __str_count(this, substring);
    }
}

func str(obj) -> string {
    if (type(obj) == "string") {
        return obj;
    }

    if (type(obj) == "object") {
        try {
            let converted = obj.toString();
            if (type(converted) == "string") {
                return converted;
            }
            return __builtin_str(converted);
        } catch (e) {
            return __builtin_str(obj);
        }
    }

    return __builtin_str(obj);
}
