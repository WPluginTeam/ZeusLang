using original;

// These declarations use the dynamic ZeusValue callback ABI. The methods below
// keep their public receiver and return types as native `string` values.
@native("zeus_string_builtin_str")
decl func __builtin_str(value);

@native("zeus_string_builtin_type")
decl func type(value);

@native("zeus_string_builtin_len")
decl func len(value);

@native("zeus_string_get")
decl func __str_get(value, index);

@native("zeus_string_slice")
decl func __str_slice(value, start, end);

@native("zeus_string_index")
decl func __str_index(value, substring);

@native("zeus_string_rindex")
decl func __str_rindex(value, substring);

@native("zeus_string_replace")
decl func __str_replace(value, old, replacement);

@native("zeus_string_split")
decl func __str_split(value, separator);

@native("zeus_string_startswith")
decl func __str_startswith(value, prefix);

@native("zeus_string_endswith")
decl func __str_endswith(value, suffix);

@native("zeus_string_lower")
decl func __str_lower(value);

@native("zeus_string_upper")
decl func __str_upper(value);

@native("zeus_string_count")
decl func __str_count(value, substring);

// String literals and all methods use the native `string` representation.
impl string {
    using &this;

    // new string(value) is a value factory; it does not allocate a class object.
    func operator[new](value = "") -> string {
        if (type(value) == "string") {
            return value;
        }
        return __builtin_str(value);
    }

    func length() -> int {
        return len(this);
    }

    func toString() -> string {
        return this;
    }

    func nativeString() -> string {
        return this;
    }

    func isEmpty() -> bool {
        return len(this) == 0;
    }

    func clone() -> string {
        return this;
    }

    func get(index: int) -> string {
        return __str_get(this, index);
    }

    func slice(start: int, end: int) -> string {
        return __str_slice(this, start, end);
    }

    func index(substring: string) -> int {
        return __str_index(this, substring);
    }

    func rindex(substring: string) -> int {
        return __str_rindex(this, substring);
    }

    func replace(old: string, replacement: string) -> string {
        return __str_replace(this, old, replacement);
    }

    func split(separator: string) {
        return __str_split(this, separator);
    }

    func startswith(prefix: string) -> bool {
        return __str_startswith(this, prefix);
    }

    func endswith(suffix: string) -> bool {
        return __str_endswith(this, suffix);
    }

    func lower() -> string {
        return __str_lower(this);
    }

    func upper() -> string {
        return __str_upper(this);
    }

    func count(substring: string) -> int {
        return __str_count(this, substring);
    }
}

func str(obj) -> string {
    if (type(obj) == "string") {
        return obj;
    }

    if (type(obj) == "object") {
        try {
            let converted = obj.toString();
            if (type(converted) == "string") {
                return converted;
            }
            return __builtin_str(converted);
        } catch (e) {
            return __builtin_str(obj);
        }
    }

    return __builtin_str(obj);
}
