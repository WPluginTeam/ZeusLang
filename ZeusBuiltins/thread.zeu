
// Thread for Zeus
// Created 2025/11/27 by Himpq
// Updated with native threading support
// Updated 2025/12/02: Added Lock, RLock, Semaphore, Event, Barrier classes

// Note: Thread.start() only supports Zeus closures, not native functions like print
// 多 VM 共享机制：子线程通过 sharedClasses/sharedObjects 等指针共享主 VM 的数据
// 因此全局对象可以直接在子线程中访问

var _Global_Thread_Pool = [];

// ===== Lock (Mutex) =====
// 基本的互斥锁，用于保护临界区
// 
// 用法:
//   var lock = new Lock();
//   
//   func worker() {
//       lock.acquire();
//       // 临界区代码
//       lock.release();
//   }
//
// 或使用 with 语法（推荐）:
//   lock.with(func() {
//       // ... 临界区代码 ...
//   });

class Lock {
    using &this;
    
    let _mutex_id = -1;
    let _locked = false;
    
    func init() {
        this._mutex_id = __mutex_create();
    }
    
    // 获取 mutex ID
    func getMutexId() {
        return this._mutex_id;
    }
    
    // 获取锁（阻塞直到获取成功）
    func acquire() {
        __mutex_lock(this._mutex_id);
        this._locked = true;
    }
    
    // 尝试获取锁（非阻塞），返回是否成功
    func tryAcquire() {
        let result = __mutex_trylock(this._mutex_id);

        if (result) {
            this._locked = true;
        }

        return result;
    }
    
    // 释放锁
    func release() {
        __mutex_unlock(this._mutex_id);
        this._locked = false;
    }
    
    // 使用锁执行函数（自动获取和释放锁）
    func with(fn) {
        this.acquire();
        let result = fn();
        this.release();
        return result;
    }
    
    // 检查锁是否被当前持有
    func isLocked() {
        return this._locked;
    }
    
    func operator[~]() {

        if (this._mutex_id >= 0) {

            if (this._locked) {
                __mutex_unlock(this._mutex_id);
            }

            __mutex_destroy(this._mutex_id);
            this._mutex_id = -1;
        }
    }
}

// ===== 快捷函数：创建共享锁 =====
// 返回一个可以在多线程间共享的 mutex ID
// 用法:
//   var shared myLock = create_shared_lock();
//   
//   func worker() {
//       lock_acquire(myLock);
//       // 临界区
//       lock_release(myLock);
//   }

func create_shared_lock() {
    return __mutex_create();
}

func lock_acquire(mutexId) {
    __mutex_lock(mutexId);
}

func lock_tryacquire(mutexId) {
    return __mutex_trylock(mutexId);
}

func lock_release(mutexId) {
    __mutex_unlock(mutexId);
}

func lock_destroy(mutexId) {
    __mutex_destroy(mutexId);
}

// ===== RLock (Reentrant Lock) =====
// 可重入锁，同一线程可以多次获取
// 注意：这是在 Zeus 层面实现的简化版本

class RLock {
    using &this;
    
    let _mutex_id = -1;
    let _owner_thread = -1;
    let _count = 0;
    
    func init() {
        this._mutex_id = __mutex_create();
    }
    
    func acquire() {
        let current = __thread_current_id();
        
        if (this._owner_thread == current) {
            // 同一线程重入
            this._count = this._count + 1;
            return;
        }
        
        // 不同线程，需要等待锁
        __mutex_lock(this._mutex_id);
        this._owner_thread = current;
        this._count = 1;
    }
    
    func tryAcquire() {
        let current = __thread_current_id();
        
        if (this._owner_thread == current) {
            this._count = this._count + 1;
            return true;
        }
        
        let result = __mutex_trylock(this._mutex_id);
        if (result) {
            this._owner_thread = current;
            this._count = 1;
        }
        return result;
    }
    
    func release() {
        let current = __thread_current_id();
        
        if (this._owner_thread != current) {
            // 不是锁的持有者
            return;
        }
        
        this._count = this._count - 1;
        if (this._count == 0) {
            this._owner_thread = -1;
            __mutex_unlock(this._mutex_id);
        }
    }
    
    func with(fn) {
        this.acquire();
        let result = fn();
        this.release();
        return result;
    }
    
    func operator[~]() {
        if (this._mutex_id >= 0) {
            // 释放所有重入计数
            for (this._count > 0) {
                __mutex_unlock(this._mutex_id);
                this._count = this._count - 1;
            }
            __mutex_destroy(this._mutex_id);
            this._mutex_id = -1;
        }
    }
}

// ===== Semaphore =====
// 信号量，用于限制并发访问数量
// 使用 shared 变量实现跨线程同步

class Semaphore {
    using &this;
    
    let _mutex_id = -1;
    let _count = 0;
    let _max_count = 1;
    
    func init(count=1) {
        this._mutex_id = __mutex_create();
        this._count = count;
        this._max_count = count;
    }
    
    // 获取信号量（计数减1）
    func acquire() {
        // 自旋等待直到有可用计数
        for (true) {
            __mutex_lock(this._mutex_id);
            if (this._count > 0) {
                this._count = this._count - 1;
                __mutex_unlock(this._mutex_id);
                return;
            }
            __mutex_unlock(this._mutex_id);
            // 短暂休眠避免 CPU 空转
            __thread_sleep(1);
        }
    }
    
    // 尝试获取信号量（非阻塞）
    func tryAcquire() {
        __mutex_lock(this._mutex_id);
        if (this._count > 0) {
            this._count = this._count - 1;
            __mutex_unlock(this._mutex_id);
            return true;
        }
        __mutex_unlock(this._mutex_id);
        return false;
    }
    
    // 释放信号量（计数加1）
    func release() {
        __mutex_lock(this._mutex_id);
        if (this._count < this._max_count) {
            this._count = this._count + 1;
        }
        __mutex_unlock(this._mutex_id);
    }
    
    // 获取当前可用计数
    func available() {
        __mutex_lock(this._mutex_id);
        let c = this._count;
        __mutex_unlock(this._mutex_id);
        return c;
    }
    
    func operator[~]() {
        if (this._mutex_id >= 0) {
            __mutex_destroy(this._mutex_id);
            this._mutex_id = -1;
        }
    }
}

// ===== Event =====
// 事件对象，用于线程间信号通知

class Event {
    using &this;
    
    let _mutex_id = -1;
    let _flag = false;
    
    func init() {
        this._mutex_id = __mutex_create();
    }
    
    // 设置事件（唤醒等待的线程）
    func set() {
        __mutex_lock(this._mutex_id);
        this._flag = true;
        __mutex_unlock(this._mutex_id);
    }
    
    // 清除事件
    func clear() {
        __mutex_lock(this._mutex_id);
        this._flag = false;
        __mutex_unlock(this._mutex_id);
    }
    
    // 检查事件是否被设置
    func isSet() {
        __mutex_lock(this._mutex_id);
        let f = this._flag;
        __mutex_unlock(this._mutex_id);
        return f;
    }
    
    // 等待事件被设置（阻塞）
    // timeout: 超时毫秒数，-1 表示无限等待
    // 返回: true 如果事件被设置，false 如果超时
    func wait(timeout=-1) {
        let start = 0;  // TODO: 需要 __time_ms() 函数
        
        for (true) {
            __mutex_lock(this._mutex_id);
            if (this._flag) {
                __mutex_unlock(this._mutex_id);
                return true;
            }
            __mutex_unlock(this._mutex_id);
            
            // TODO: 实现超时检查
            // 目前只支持无限等待
            __thread_sleep(1);
        }
    }
    
    func operator[~]() {
        if (this._mutex_id >= 0) {
            __mutex_destroy(this._mutex_id);
            this._mutex_id = -1;
        }
    }
}

// ===== Barrier =====
// 屏障，用于同步多个线程到达某个点

class Barrier {
    using &this;
    
    let _mutex_id = -1;
    let _parties = 0;      // 需要等待的线程数
    let _waiting = 0;      // 当前等待的线程数
    let _generation = 0;   // 代数，用于重置
    
    func init(parties) {
        this._mutex_id = __mutex_create();
        this._parties = parties;
    }
    
    // 等待所有线程到达屏障
    // 返回当前线程是第几个到达的（0-based）
    func wait() {
        __mutex_lock(this._mutex_id);
        let my_gen = this._generation;
        let index = this._waiting;
        this._waiting = this._waiting + 1;
        
        if (this._waiting >= this._parties) {
            // 最后一个到达，释放所有线程
            this._waiting = 0;
            this._generation = this._generation + 1;
            __mutex_unlock(this._mutex_id);
            return index;
        }
        __mutex_unlock(this._mutex_id);
        
        // 等待其他线程
        for (true) {
            __mutex_lock(this._mutex_id);
            if (this._generation != my_gen) {
                // 代数变了，说明所有线程已到达
                __mutex_unlock(this._mutex_id);
                return index;
            }
            __mutex_unlock(this._mutex_id);
            __thread_sleep(1);
        }
    }
    
    // 重置屏障
    func reset() {
        __mutex_lock(this._mutex_id);
        this._waiting = 0;
        this._generation = this._generation + 1;
        __mutex_unlock(this._mutex_id);
    }
    
    func operator[~]() {
        if (this._mutex_id >= 0) {
            __mutex_destroy(this._mutex_id);
            this._mutex_id = -1;
        }
    }
}

// ===== Thread Pool =====
// 线程池，用于管理一组工作线程

class ThreadPool {
    using &this;
    
    let _workers = [];
    let _size = 0;
    let _tasks = [];        // 任务队列
    let _mutex_id = -1;
    let _shutdown = false;
    
    func init(size=4) {
        this._size = size;
        this._mutex_id = __mutex_create();
        // 注意：工作线程在 start() 中创建
    }
    
    // 提交任务到线程池
    func submit(task) {
        __mutex_lock(this._mutex_id);
        this._tasks.append(task);
        __mutex_unlock(this._mutex_id);
    }
    
    // 获取任务（由工作线程调用）
    func _getTask() {
        __mutex_lock(this._mutex_id);
        if (len(this._tasks) > 0) {
            let task = this._tasks[0];
            this._tasks.remove(0);
            __mutex_unlock(this._mutex_id);
            return task;
        }
        __mutex_unlock(this._mutex_id);
        return nil;
    }
    
    // 工作线程主循环
    func _workerLoop() {
        for (!this._shutdown) {
            let task = this._getTask();
            if (task != nil) {
                task();
            } else {
                __thread_sleep(10);  // 没有任务时休眠
            }
        }
    }
    
    // 启动线程池
    func start() {
        for (0..this._size) [i] {
            let worker = new Thread(this._workerLoop);
            worker.start();
            this._workers.append(worker);
        }
    }
    
    // 关闭线程池
    func shutdown(wait=true) {
        this._shutdown = true;
        if (wait) {
            for (0..len(this._workers)) [i] {
                this._workers[i].join();
            }
        }
    }
    
    // 获取待处理任务数量
    func pendingTasks() {
        __mutex_lock(this._mutex_id);
        let count = len(this._tasks);
        __mutex_unlock(this._mutex_id);
        return count;
    }
    
    func operator[~]() {
        this.shutdown(false);
        if (this._mutex_id >= 0) {
            __mutex_destroy(this._mutex_id);
            this._mutex_id = -1;
        }
    }
}

class Thread {
    using &this;

    let _Thread_ID = -1;
    let _is_alive = false;
    let target = nil;
    let args = nil;
    let name = nil;

    func init (target, args=nil, name=nil) {
        this.target = target;
        this.args = args;
        this.name = name;
    }

    func start () {
        // 创建新线程
        this._Thread_ID = __thread_create();
        
        // 设置线程名
        if (this.name != nil) {
            __thread_set_name(this._Thread_ID, this.name);
        }
        
        // 先设置 _is_alive，再启动线程
        // 避免竞争条件：子线程可能在 start() 返回前就完成并删除对象
        this._is_alive = true;
        
        // 直接传递 target 闭包启动线程
        // Note: args passing is not yet fully supported in thread model
        __thread_start(this._Thread_ID, this.target);
    }

    func getName() {
        if (this._Thread_ID >= 0) {
            return __thread_get_name(this._Thread_ID);
        }

        return this.name;
    }

    func setName(name) {
        this.name = name;

        if (this._Thread_ID >= 0) {
            __thread_set_name(this._Thread_ID, name);
        }
    }

    func join () {
        if (this._Thread_ID >= 0) {
            __thread_join(this._Thread_ID);
            this._is_alive = false;
        }
    }

    func eliminate () {
        if (this._Thread_ID >= 0) {
            __thread_eliminate(this._Thread_ID);
            this._is_alive = false;
        }
    }

    func isAlive () {
        if (this._Thread_ID >= 0) {
            return __thread_is_alive(this._Thread_ID);
        }

        return false;
    }

    func operator[~] () {
        // 析构函数：确保线程资源被正确释放
        // 如果线程仍在运行，等待它完成（不强制终止，避免数据损坏）
        if (this._Thread_ID >= 0) {
            if (this._is_alive) {
                // 注意：这里使用 join 而不是 eliminate
                // 因为强制终止可能导致资源泄漏或数据损坏
                __thread_join(this._Thread_ID);
            }

            this._is_alive = false;
            this.target = nil;
            this.args = nil;
            this.name = nil;
            this._Thread_ID = -1;
        }
    }
}

// Thread utility functions
func thread_sleep(ms) {
    __thread_sleep(ms);
}

func thread_count() {
    return __thread_count();
}

func thread_active_count() {
    return __thread_active_count();
}

func thread_join_all() {
    __thread_join_all();
}

func thread_current_id() {
    return __thread_current_id();
}
