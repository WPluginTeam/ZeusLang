// RFC 4180 style CSV reader and writer for string and array data.

import zeus.byte;
import zeus.exception;
import zeus.string;

func __csv_validate_delimiter(delimiter: string) -> int {
    let raw = bytes(delimiter);
    if (raw.length() != 1) {
        throw new Exception("CSV delimiter must be exactly one ASCII byte");
    }
    let value = raw.get(0);
    if (value > 127 or value == 34 or value == 10 or value == 13) {
        throw new Exception("CSV delimiter cannot be a quote or line break");
    }
    return value;
}

func __csv_finish_field(row, fieldBuffer) {
    row.append(fieldBuffer.toBytes().decode("utf-8"));
    fieldBuffer.clear();
}

func __csv_double_quotes(value: string) -> string {
    let raw = bytes(value);
    let output = "";
    let start = 0;
    for (0..raw.length()) [const &i] {
        if (raw.get(i) == 34) {
            output = output + raw.slice(start, i).decode("utf-8") + "\"\"";
            start = i + 1;
        }
    }
    return output + raw.slice(start, raw.length()).decode("utf-8");
}

class CSV {
    func static parse(text: string, delimiter: string=",") {
        let separator = __csv_validate_delimiter(delimiter);
        let source = bytes(text);
        let output = [];
        if (source.length() == 0) return output;

        let row = [];
        let fieldBuffer = new ByteBuffer();
        let state = 0; // 0=unquoted, 1=quoted, 2=after closing quote
        let recordPending = false;
        let index = 0;
        for (index < source.length()) {
            let current = source.get(index);
            if (state == 1) {
                if (current == 34) {
                    if (index + 1 < source.length() and source.get(index + 1) == 34) {
                        fieldBuffer.append(bytes([34]));
                        index = index + 2;
                    } else {
                        state = 2;
                        index = index + 1;
                    }
                } else {
                    fieldBuffer.append(source.slice(index, index + 1));
                    index = index + 1;
                }
            } else if (state == 2) {
                if (current == separator) {
                    __csv_finish_field(row, fieldBuffer);
                    recordPending = true;
                    state = 0;
                    index = index + 1;
                } else if (current == 10 or current == 13) {
                    __csv_finish_field(row, fieldBuffer);
                    output.append(row);
                    row = [];
                    recordPending = false;
                    state = 0;
                    if (current == 13 and index + 1 < source.length() and
                        source.get(index + 1) == 10) {
                        index = index + 2;
                    } else {
                        index = index + 1;
                    }
                } else {
                    throw new Exception("CSV data after a closing quote must be a delimiter or line break");
                }
            } else if (current == 34) {
                if (fieldBuffer.length() != 0) {
                    throw new Exception("CSV quote must appear at the start of a field");
                }
                state = 1;
                recordPending = true;
                index = index + 1;
            } else if (current == separator) {
                __csv_finish_field(row, fieldBuffer);
                recordPending = true;
                index = index + 1;
            } else if (current == 10 or current == 13) {
                __csv_finish_field(row, fieldBuffer);
                output.append(row);
                row = [];
                recordPending = false;
                if (current == 13 and index + 1 < source.length() and
                    source.get(index + 1) == 10) {
                    index = index + 2;
                } else {
                    index = index + 1;
                }
            } else {
                fieldBuffer.append(source.slice(index, index + 1));
                recordPending = true;
                index = index + 1;
            }
        }

        if (state == 1) throw new Exception("CSV quoted field is not terminated");
        if (recordPending or row.length() > 0 or fieldBuffer.length() > 0) {
            __csv_finish_field(row, fieldBuffer);
            output.append(row);
        }
        return output;
    }

    func static stringify(rows, delimiter: string=",") -> string {
        let separator = __csv_validate_delimiter(delimiter);
        let delimiterText = bytes([separator]).decode("utf-8");
        let output = "";
        for (0..rows.length()) [const &rowIndex] {
            let row = rows.get(rowIndex);
            for (0..row.length()) [const &fieldIndex] {
                if (fieldIndex > 0) output = output + delimiterText;
                let field = str(row.get(fieldIndex));
                let mustQuote = field.index(delimiterText) >= 0 or
                    field.index("\"") >= 0 or field.index("\r") >= 0 or
                    field.index("\n") >= 0;
                if (mustQuote) {
                    let escaped = __csv_double_quotes(field);
                    output = output + "\"" + escaped + "\"";
                } else {
                    output = output + field;
                }
            }
            if (rowIndex + 1 < rows.length()) output = output + "\r\n";
        }
        return output;
    }
}
