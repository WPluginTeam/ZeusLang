
// I/O functions for Zeus

// Helper function to convert value to native string
func _toStr(val) {
    using original {
        let valType = type(val);
        if (valType == "string") {
            return val;
        } else {
            try {
                let converted = val.toString();
                if (type(converted) == "string") return converted;
                return __builtin_str(converted);
            } catch (e) {
                return str(val);
            }
        }
    }
}

// Build string from array of values with separator
func _joinArray(arr, sep) {
    let len_arr = len(arr);

    if (len_arr == 0) {
        return "";
    }

    let result = _toStr(arr[0]);

    for (1..len_arr) [const &index] {
        result = result + sep + _toStr(arr[index]);
    }

    return result;
}

// Enhanced print function supporting **kwargs
// Usage: print(*args, **kwargs) where kwargs can contain sep="" and end=""
func print(*args, **kwargs) {
    let len_args = len(args);
    let sep = " ";
    let end = "\n";

    // Extract sep and end from kwargs
    let kwargs_type = type(kwargs);

    if (kwargs_type == "dict" || kwargs_type == "object") {
        for (kwargs) [const &key : ... value] {
            if (key == "sep") {
                sep = _toStr(value);
            } else if (key == "end") {
                end = _toStr(value);
            }
        }
    }

    if (len_args == 0) {
        _write(end);
        return nil;
    }

    let output = _joinArray(args, sep);

    _write(output + end);

    return nil;
}
