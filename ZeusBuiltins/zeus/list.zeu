// Array is the language-facing implementation of the native array value.
@native("zeus_value_array_push")
decl func __array_push(array, value);

@native("zeus_value_array_pop")
decl func __array_pop(array);

@native("zeus_value_array_get")
decl func __array_get(array, index);

@native("zeus_value_array_set")
decl func __array_set(array, index, value);

@native("zeus_value_array_clear")
decl func __array_clear(array);

@native("zeus_value_array_slice")
decl func __array_slice(array, start, end);

@native("zeus_value_array_length_i64")
decl func __array_length_i64(array: Array) -> int;

impl Array {
    using &this;

    func operator[new](value=nil) -> Array {
        if (value == nil) return [];
        if (type(value) != "Array") {
            throw new Exception("Array constructor expects an Array or nil");
        }
        return value;
    }

    func append(value) {
        __array_push(this, value);
        return this;
    }

    // 原地删除指定下标（后面的元素前移），返回 nil。
    // 旧实现返回新数组，调用方写成 `arr = arr.remove(0)` 才正确，容易漏掉赋值；
    // 与 Python 的 list.pop(index) 一样改自身，原地语义不需要再回填。
    func remove(index) {
        let count = this.length();
        if (index < 0 or index >= count) return nil;
        let cursor = index;
        for (cursor < count - 1) {
            this[cursor] = this[cursor + 1];
            cursor = cursor + 1;
        }
        __array_pop(this);
        return nil;
    }

    func pop() {
        return __array_pop(this);
    }

    @no_safepoint inline func length() -> int {
        using LLVM {
            return __array_length_i64(this);
        }
        using VM {
            return len(this);
        }
    }

    func get(index) {
        return this[index];
    }

    func set(index, value) -> Array {
        __array_set(this, index, value);
        return this;
    }

    func toString() -> string {
        let result = "[";
        for (this) [const &item] {
            result = result + str(item) + ", ";
        }
        if (this.length() > 0) {
            result = result.slice(0, result.length() - 2);
        }
        return result + "]";
    }

    func operator[+](other) -> Array {
        let result = [];
        for (this) [const &item] {
            result.append(item);
        }
        for (other) [const &item] {
            result.append(item);
        }
        return result;
    }

    func sort() -> Array {
        let target = this;
        let n = target.length();
        let i = 0;
        for (i < n - 1) {
            let j = 0;
            for (j < n - i - 1) {
                if (target[j] > target[j + 1]) {
                    let tmp = target[j];
                    target[j] = target[j + 1];
                    target[j + 1] = tmp;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return target;
    }

    func clear() -> Array {
        __array_clear(this);
        return this;
    }

    func copy() -> Array {
        let result = [];
        for (this) [const &item] {
            result.append(item);
        }
        return result;
    }
}

// 构造连续数字序列数组。当只传一个参数时默认从 0 开始。
// 支持正负 step 以及包含式 (inclusive=true) 参数。
func range(start, end=nil, step=1, inclusive=false) {
    if (end == nil) {
        end = start;
        start = 0;
    }
    let result = [];
    if (step > 0) {
        let cur = start;
        if (inclusive) {
            for (cur <= end) {
                result.append(cur);
                cur = cur + step;
            }
        } else {
            for (cur < end) {
                result.append(cur);
                cur = cur + step;
            }
        }
    } else if (step < 0) {
        let cur = start;
        if (inclusive) {
            for (cur >= end) {
                result.append(cur);
                cur = cur + step;
            }
        } else {
            for (cur > end) {
                result.append(cur);
                cur = cur + step;
            }
        }
    }
    return result;
}
