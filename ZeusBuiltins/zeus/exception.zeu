
// Exception module for Zeus
// Created 2025/12/02 by Himpq
// Provides Exception class for try-catch-throw mechanism

// ===== Exception 基类 =====
// 所有异常的基类，包含消息和堆栈跟踪信息
//
// 用法:
//   throw new Exception("Something went wrong");
//
//   try {
//       // 可能抛出异常的代码
//   } catch (&e) {
//       print("Error:", e.getMessage());
//   }

class Exception {
    using &this;
    
    let _message = "";
    let _type = "Exception";
    
    func init(message: string = "") {
        this._message = message;
    }
    
    func getMessage() {
        return this._message;
    }
    
    func getType() {
        return this._type;
    }
    
    func toString() {
        return this._type + ": " + this._message;
    }
}

