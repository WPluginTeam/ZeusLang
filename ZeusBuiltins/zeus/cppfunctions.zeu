// cppfunctions.zeu
// 底层C++函数封装模块

// array命名空间 - 数组操作
class array {
    
    // 这些是占位符，实际实现在VM的内置函数中
    func static push(arr, value) { return __array_push(arr, value); }
    func static pop(arr) { return __array_pop(arr); }
    func static get(arr, index) { return __array_get(arr, index); }
    func static set(arr, index, value) { return __array_set(arr, index, value); }
    func static clear(arr) { return __array_clear(arr); }
    func static slice(arr, start, end) { return __array_slice(arr, start, end); }
}

// object命名空间 - 对象操作
class object {
    
    // 零拷贝对象字段访问
    func static objget(obj, field, key) { return __objget(obj, field, key); }
    func static objset(obj, field, key, value) { return __objset(obj, field, key, value); }
    
    // 属性访问（同时保留全局版本）
    func static getattr(obj, attrName) { return getattr(obj, attrName); }
    func static setattr(obj, attrName, value) { return setattr(obj, attrName, value); }
}

// global命名空间 - 全局变量操作
class global {
    
    func static get(index) { return __getglobal(index); }
    func static set(index, value) { return __setglobal(index, value); }
    func static load(name) { return __loadglobal(name); }
    func static store(name, value) { return __storeglobal(name, value); }
}

// conversion命名空间 - 类型转换
class conversion {
    
    func static int(value) { return int(value); }
    func static float(value) { return float(value); }
    func static str(value) { return str(value); }
    func static type(value) { return type(value); }
}

// io命名空间 - 输入输出（保留全局print）
class io {

    func static input(s="") -> string { print(s); return input(); }
}
