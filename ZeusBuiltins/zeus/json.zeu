// JSON parsing and serialization implemented in Zeus. Strings are scanned as
// UTF-8 bytes so the JSON grammar stays independent of the host locale.
using original;
import zeus.exception;
import zeus.list;
import zeus.string;

@native("zeus_bytes_get")
decl func __bytes_get(data: bytes, index: int) -> int;

@native("zeus_bytes_len")
decl func __bytes_len(data: bytes) -> int;

@native("zeus_bytes_decode")
decl func __bytes_decode(data: bytes, encoding: string) -> string;

func __json_zeros(count: int) -> string {
    if (count <= 0) return "";
    let result: string = "";
    let chunk: string = "0";
    let remaining: int = count;
    for (remaining > 0) {
        if (remaining % 2 == 1) result = result + chunk;
        remaining = int(remaining / 2);
        if (remaining > 0) chunk = chunk + chunk;
    }
    return result;
}

func __json_is_digit(value: int) -> bool {
    return value >= 48 and value <= 57;
}

func __json_is_hex_digit(value: int) -> int {
    if (value >= 48 and value <= 57) return value - 48;
    if (value >= 65 and value <= 70) return value - 55;
    if (value >= 97 and value <= 102) return value - 87;
    return -1;
}

func __json_is_continuation(value: int) -> bool {
    return value >= 128 and value <= 191;
}

// Return the byte width for a valid UTF-8 scalar beginning at index, or zero.
@no_safepoint
func __json_utf8_sequence_length(data: bytes, index: int, total: int) -> int {
    if (index < 0 or index >= total) return 0;
    let first: int = __bytes_get(data, index);
    if (first < 128) return 1;

    if (first >= 194 and first <= 223) {
        if (index + 1 >= total) return 0;
        if (!__json_is_continuation(__bytes_get(data, index + 1))) return 0;
        return 2;
    }

    if (first >= 224 and first <= 239) {
        if (index + 2 >= total) return 0;
        let second: int = __bytes_get(data, index + 1);
        let third: int = __bytes_get(data, index + 2);
        if (!__json_is_continuation(third)) return 0;
        if (first == 224) {
            if (second < 160 or second > 191) return 0;
        } else if (first == 237) {
            if (second < 128 or second > 159) return 0;
        } else if (!__json_is_continuation(second)) {
            return 0;
        }
        return 3;
    }

    if (first >= 240 and first <= 244) {
        if (index + 3 >= total) return 0;
        let second: int = __bytes_get(data, index + 1);
        if (!__json_is_continuation(__bytes_get(data, index + 2)) or
            !__json_is_continuation(__bytes_get(data, index + 3))) return 0;
        if (first == 240) {
            if (second < 144 or second > 191) return 0;
        } else if (first == 244) {
            if (second < 128 or second > 143) return 0;
        } else if (!__json_is_continuation(second)) {
            return 0;
        }
        return 4;
    }
    return 0;
}

func __json_codepoint_string(codepoint: int) -> string {
    if (codepoint < 0 or codepoint > 1114111 or
        (codepoint >= 55296 and codepoint <= 57343)) {
        throw new Exception("Invalid Unicode code point in JSON string");
    }

    let encoded: bytes = bytes();
    if (codepoint <= 127) {
        encoded = bytes([codepoint]);
    } else if (codepoint <= 2047) {
        encoded = bytes([
            192 + int(codepoint / 64),
            128 + codepoint % 64
        ]);
    } else if (codepoint <= 65535) {
        encoded = bytes([
            224 + int(codepoint / 4096),
            128 + int(codepoint / 64) % 64,
            128 + codepoint % 64
        ]);
    } else {
        encoded = bytes([
            240 + int(codepoint / 262144),
            128 + int(codepoint / 4096) % 64,
            128 + int(codepoint / 64) % 64,
            128 + codepoint % 64
        ]);
    }
    return __bytes_decode(encoded, "utf-8");
}

class JSONParser {
    using &this;

    let source: string = "";
    let sourceBytes: bytes = bytes();
    let index: int = 0;
    let byteLength: int = 0;

    func init(text: string) {
        this.source = text;
        this.sourceBytes = bytes(text);
        this.index = 0;
        this.byteLength = __bytes_len(this.sourceBytes);
    }

    func fail(message: string) {
        throw new Exception(
            "JSON parse error at byte " + __builtin_str(this.index) + ": " + message);
    }

    @no_safepoint
    func readHex4(startIndex: int) -> int {
        let byteLength: int = this.byteLength;
        if (startIndex + 4 > byteLength) {
            this.index = startIndex;
            this.fail("incomplete Unicode escape");
        }
        let value: int = 0;
        for (0..4) [const &i] {
            let digit: int = __json_is_hex_digit(__bytes_get(this.sourceBytes, startIndex + i));
            if (digit < 0) {
                this.index = startIndex + i;
                this.fail("invalid hexadecimal digit in Unicode escape");
            }
            value = value * 16 + digit;
        }
        this.index = startIndex + 4;
        return value;
    }

    @no_safepoint
    func parseString(startIndex: int) -> string {
        let source: string = this.source;
        let byteLength: int = this.byteLength;
        let index: int = startIndex;
        if (index >= byteLength) {
            this.index = index;
            this.fail("expected a string");
        }
        if (__bytes_get(this.sourceBytes, index) != 34) {
            this.index = index;
            this.fail("expected a string");
        }
        index = index + 1;

        let segmentStart: int = index;
        for (true) {
            if (index >= byteLength) {
                this.index = index;
                this.fail("unterminated string");
            }
            let current: int = __bytes_get(this.sourceBytes, index);
            if (current == 34) {
                this.index = index + 1;
                return __str_slice(source, segmentStart, index);
            }
            if (current < 32) {
                this.index = index;
                this.fail("unescaped control character in string");
            }

            if (current == 92) {
                return this.parseEscapedString(
                    source, byteLength, segmentStart, index);
            } else if (current >= 128) {
                let width: int = __json_utf8_sequence_length(
                    this.sourceBytes, index, byteLength);
                if (width == 0) {
                    this.index = index;
                    this.fail("invalid UTF-8 in string");
                }
                index = index + width;
            } else {
                index = index + 1;
            }
        }
        return "";
    }

    @no_safepoint
    func parseEscapedString(
        source: string, byteLength: int,
        segmentStart: int, escapeIndex: int
    ) -> string {
        let parts: list = [];
        let index: int = escapeIndex;
        for (true) {
            if (index >= byteLength) {
                this.index = index;
                this.fail("unterminated string");
            }
            let current: int = __bytes_get(this.sourceBytes, index);
            if (current == 34) {
                if (index > segmentStart) {
                    parts.append(__str_slice(source, segmentStart, index));
                }
                this.index = index + 1;
                using LLVM {
                    return string_join(parts, "");
                }
                using VM {
                    return __json_join_fragments(parts, 0, parts.length());
                }
            }
            if (current < 32) {
                this.index = index;
                this.fail("unescaped control character in string");
            }

            if (current == 92) {
                if (index > segmentStart) {
                    parts.append(__str_slice(source, segmentStart, index));
                }
                index = index + 1;
                if (index >= byteLength) {
                    this.index = index;
                    this.fail("incomplete escape sequence");
                }

                let escape: int = __bytes_get(this.sourceBytes, index);
                index = index + 1;
                when (escape) {
                    34: parts.append("\"");
                    92: parts.append("\\");
                    47: parts.append("/");
                    98: parts.append("\b");
                    102: parts.append("\f");
                    110: parts.append("\n");
                    114: parts.append("\r");
                    116: parts.append("\t");
                    117: {
                        let codepoint: int = this.readHex4(index);
                        index = index + 4;
                        if (codepoint >= 55296 and codepoint <= 56319) {
                            if (index + 6 > byteLength) {
                                this.index = index;
                                this.fail("high surrogate must be followed by a low surrogate");
                            }
                            if (__bytes_get(this.sourceBytes, index) != 92 or
                                __bytes_get(this.sourceBytes, index + 1) != 117) {
                                this.index = index;
                                this.fail("high surrogate must be followed by a low surrogate");
                            }
                            index = index + 2;
                            let lowSurrogate: int = this.readHex4(index);
                            index = index + 4;
                            if (lowSurrogate < 56320 or lowSurrogate > 57343) {
                                this.index = index;
                                this.fail("invalid low surrogate");
                            }
                            codepoint = 65536 + (codepoint - 55296) * 1024 +
                                (lowSurrogate - 56320);
                        } else if (codepoint >= 56320 and codepoint <= 57343) {
                            this.index = index;
                            this.fail("unexpected low surrogate");
                        }
                        parts.append(__json_codepoint_string(codepoint));
                    }
                    else: {
                        this.index = index;
                        this.fail("invalid escape sequence");
                    }
                }
                segmentStart = index;
            } else if (current >= 128) {
                let width: int = __json_utf8_sequence_length(
                    this.sourceBytes, index, byteLength);
                if (width == 0) {
                    this.index = index;
                    this.fail("invalid UTF-8 in string");
                }
                index = index + width;
            } else {
                index = index + 1;
            }
        }
        return "";
    }

    func expandExponent(token: string) -> string {
        let tokenBytes: bytes = bytes(token);
        let tokenLength: int = __bytes_len(tokenBytes);
        let exponentMarker: int = -1;
        let decimalPoint: int = -1;
        for (0..tokenLength) [const &i] {
            let current: int = __bytes_get(tokenBytes, i);
            if (current == 69 or current == 101) {
                exponentMarker = i;
                break;
            }
            if (current == 46) decimalPoint = i;
        }
        if (exponentMarker < 0) return token;

        let negative: bool = __bytes_get(tokenBytes, 0) == 45;
        let mantissaStart: int = 0;
        if (negative) mantissaStart = 1;

        // The mantissa is taken in one slice. Collecting it digit by digit
        // copied the accumulator once per digit.
        let mantissa: string = __str_slice(token, mantissaStart, exponentMarker);
        let digits: string = mantissa;
        let integerDigits: int = exponentMarker - mantissaStart;
        if (decimalPoint >= 0) {
            digits = __str_replace(mantissa, ".", "");
            integerDigits = decimalPoint - mantissaStart;
        }

        let exponentIndex: int = exponentMarker + 1;
        let exponentNegative: bool = false;
        let firstExp: int = __bytes_get(tokenBytes, exponentIndex);
        if (firstExp == 45) {
            exponentNegative = true;
            exponentIndex = exponentIndex + 1;
        } else if (firstExp == 43) {
            exponentIndex = exponentIndex + 1;
        }
        let exponent: int = 0;
        for (exponentIndex..tokenLength) [const &i] {
            let digit: int = __bytes_get(tokenBytes, i) - 48;
            if (exponent > 10000) this.fail("number exponent magnitude exceeds 100000");
            exponent = exponent * 10 + digit;
            if (exponent > 100000) this.fail("number exponent magnitude exceeds 100000");
        }
        if (exponentNegative) exponent = 0 - exponent;

        let decimalPosition: int = integerDigits + exponent;
        let result: string = "";
        if (negative) result = "-";
        if (decimalPosition <= 0) {
            return result + "0." + __json_zeros(0 - decimalPosition) + digits;
        }
        let digitLen: int = digits.length();
        if (decimalPosition >= digitLen) {
            return result + digits + __json_zeros(decimalPosition - digitLen);
        }
        return result + __str_slice(digits, 0, decimalPosition) + "." +
            __str_slice(digits, decimalPosition, digitLen);
    }

    @no_safepoint
    func parseArray(depth: int, startIndex: int) {
        let byteLength: int = this.byteLength;
        let index: int = startIndex + 1;
        for (index < byteLength) {
            let current: int = __bytes_get(this.sourceBytes, index);
            if (current != 32 and current != 9 and current != 10 and current != 13) {
                break;
            }
            index = index + 1;
        }
        let result: list = [];
        if (index < byteLength) {
            if (__bytes_get(this.sourceBytes, index) == 93) {
                this.index = index + 1;
                return result;
            }
        }

        for (true) {
            result.append(this.parseValue(depth + 1, index));
            index = this.index;
            for (index < byteLength) {
                let current: int = __bytes_get(this.sourceBytes, index);
                if (current != 32 and current != 9 and current != 10 and current != 13) {
                    break;
                }
                index = index + 1;
            }
            if (index >= byteLength) {
                this.index = index;
                this.fail("unterminated array");
            }
            let current: int = __bytes_get(this.sourceBytes, index);
            if (current == 93) {
                this.index = index + 1;
                return result;
            }
            if (current != 44) {
                this.index = index;
                this.fail("expected ',' or ']' in array");
            }
            index = index + 1;
            for (index < byteLength) {
                let whitespace: int = __bytes_get(this.sourceBytes, index);
                if (whitespace != 32 and whitespace != 9 and whitespace != 10 and
                    whitespace != 13) {
                    break;
                }
                index = index + 1;
            }
        }
    }

    @no_safepoint
    func parseObject(depth: int, startIndex: int) {
        let byteLength: int = this.byteLength;
        let index: int = startIndex + 1;
        for (index < byteLength) {
            let current: int = __bytes_get(this.sourceBytes, index);
            if (current != 32 and current != 9 and current != 10 and current != 13) {
                break;
            }
            index = index + 1;
        }
        let result: dict = {};
        if (index < byteLength) {
            if (__bytes_get(this.sourceBytes, index) == 125) {
                this.index = index + 1;
                return result;
            }
        }

        for (true) {
            if (index >= byteLength) {
                this.index = index;
                this.fail("object keys must be strings");
            }
            if (__bytes_get(this.sourceBytes, index) != 34) {
                this.index = index;
                this.fail("object keys must be strings");
            }
            let key: string = this.parseString(index);
            index = this.index;
            for (index < byteLength) {
                let whitespace: int = __bytes_get(this.sourceBytes, index);
                if (whitespace != 32 and whitespace != 9 and whitespace != 10 and
                    whitespace != 13) {
                    break;
                }
                index = index + 1;
            }
            if (index >= byteLength) {
                this.index = index;
                this.fail("expected ':' after object key");
            }
            if (__bytes_get(this.sourceBytes, index) != 58) {
                this.index = index;
                this.fail("expected ':' after object key");
            }
            index = index + 1;
            for (index < byteLength) {
                let whitespace: int = __bytes_get(this.sourceBytes, index);
                if (whitespace != 32 and whitespace != 9 and whitespace != 10 and
                    whitespace != 13) {
                    break;
                }
                index = index + 1;
            }
            result[key] = this.parseValue(depth + 1, index);
            index = this.index;
            for (index < byteLength) {
                let whitespace: int = __bytes_get(this.sourceBytes, index);
                if (whitespace != 32 and whitespace != 9 and whitespace != 10 and
                    whitespace != 13) {
                    break;
                }
                index = index + 1;
            }
            if (index >= byteLength) {
                this.index = index;
                this.fail("unterminated object");
            }
            let current: int = __bytes_get(this.sourceBytes, index);
            if (current == 125) {
                this.index = index + 1;
                return result;
            }
            if (current != 44) {
                this.index = index;
                this.fail("expected ',' or '}' in object");
            }
            index = index + 1;
            for (index < byteLength) {
                let whitespace: int = __bytes_get(this.sourceBytes, index);
                if (whitespace != 32 and whitespace != 9 and whitespace != 10 and
                    whitespace != 13) {
                    break;
                }
                index = index + 1;
            }
        }
    }

    @no_safepoint
    func parseValue(depth: int, startIndex: int) {
        let byteLength: int = this.byteLength;
        if (depth > 256) {
            this.index = startIndex;
            this.fail("maximum nesting depth exceeded");
        }
        if (startIndex >= byteLength) {
            this.index = startIndex;
            this.fail("expected a value");
        }

        let current: int = __bytes_get(this.sourceBytes, startIndex);
        when (current) {
            34: return this.parseString(startIndex);
            123: return this.parseObject(depth, startIndex);
            91: return this.parseArray(depth, startIndex);
            116: {
                if (startIndex + 4 > byteLength) {
                    this.index = startIndex;
                    this.fail("invalid literal");
                }
                if (__bytes_get(this.sourceBytes, startIndex + 1) != 114 or
                    __bytes_get(this.sourceBytes, startIndex + 2) != 117 or
                    __bytes_get(this.sourceBytes, startIndex + 3) != 101) {
                    this.index = startIndex;
                    this.fail("invalid literal");
                }
                this.index = startIndex + 4;
                return true;
            }
            102: {
                if (startIndex + 5 > byteLength) {
                    this.index = startIndex;
                    this.fail("invalid literal");
                }
                if (__bytes_get(this.sourceBytes, startIndex + 1) != 97 or
                    __bytes_get(this.sourceBytes, startIndex + 2) != 108 or
                    __bytes_get(this.sourceBytes, startIndex + 3) != 115 or
                    __bytes_get(this.sourceBytes, startIndex + 4) != 101) {
                    this.index = startIndex;
                    this.fail("invalid literal");
                }
                this.index = startIndex + 5;
                return false;
            }
            110: {
                if (startIndex + 4 > byteLength) {
                    this.index = startIndex;
                    this.fail("invalid literal");
                }
                if (__bytes_get(this.sourceBytes, startIndex + 1) != 117 or
                    __bytes_get(this.sourceBytes, startIndex + 2) != 108 or
                    __bytes_get(this.sourceBytes, startIndex + 3) != 108) {
                    this.index = startIndex;
                    this.fail("invalid literal");
                }
                this.index = startIndex + 4;
                return nil;
            }
            45, 48..57: {
                let index: int = startIndex;
                let start: int = startIndex;
                let hasFraction: bool = false;
                let hasExponent: bool = false;
                // A plain integer of at most 18 digits cannot overflow, so it
                // is accumulated without creating a token string.
                let negative: bool = false;
                let integerValue: int = 0;
                let integerDigits: int = 0;

                if (current == 45) {
                    negative = true;
                    index = index + 1;
                    if (index >= byteLength) {
                        this.index = index;
                        this.fail("incomplete number");
                    }
                    current = __bytes_get(this.sourceBytes, index);
                }

                if (current == 48) {
                    index = index + 1;
                    integerDigits = 1;
                    if (index < byteLength) {
                        if (__json_is_digit(__bytes_get(this.sourceBytes, index))) {
                            this.index = index;
                            this.fail("leading zero in number");
                        }
                    }
                } else if (current >= 49 and current <= 57) {
                    integerValue = current - 48;
                    integerDigits = 1;
                    index = index + 1;
                    for (index < byteLength) {
                        let digit: int = __bytes_get(this.sourceBytes, index) - 48;
                        if (digit < 0 or digit > 9) break;
                        if (integerDigits < 18) integerValue = integerValue * 10 + digit;
                        integerDigits = integerDigits + 1;
                        index = index + 1;
                    }
                } else {
                    this.index = index;
                    this.fail("expected a digit");
                }

                if (index < byteLength) {
                    if (__bytes_get(this.sourceBytes, index) == 46) {
                        hasFraction = true;
                        index = index + 1;
                        if (index >= byteLength) {
                            this.index = index;
                            this.fail("fraction requires at least one digit");
                        }
                        if (!__json_is_digit(__bytes_get(this.sourceBytes, index))) {
                            this.index = index;
                            this.fail("fraction requires at least one digit");
                        }
                        for (index < byteLength) {
                            let digit: int = __bytes_get(this.sourceBytes, index) - 48;
                            if (digit < 0 or digit > 9) break;
                            index = index + 1;
                        }
                    }
                }

                if (index < byteLength) {
                    current = __bytes_get(this.sourceBytes, index);
                    if (current == 69 or current == 101) {
                        hasExponent = true;
                        index = index + 1;
                        if (index < byteLength) {
                            let sign: int = __bytes_get(this.sourceBytes, index);
                            if (sign == 43 or sign == 45) {
                                index = index + 1;
                            }
                        }
                        if (index >= byteLength) {
                            this.index = index;
                            this.fail("exponent requires at least one digit");
                        }
                        if (!__json_is_digit(__bytes_get(this.sourceBytes, index))) {
                            this.index = index;
                            this.fail("exponent requires at least one digit");
                        }
                        for (index < byteLength) {
                            let digit: int = __bytes_get(this.sourceBytes, index) - 48;
                            if (digit < 0 or digit > 9) break;
                            index = index + 1;
                        }
                    }
                }

                this.index = index;
                if (!hasExponent and !hasFraction and integerDigits > 0 and
                    integerDigits <= 18) {
                    if (negative) return int(0 - integerValue);
                    return int(integerValue);
                }
                let source: string = this.source;
                let token: string = __str_slice(source, start, index);
                if (hasExponent) return float(this.expandExponent(token));
                if (hasFraction) return float(token);
                return int(token);
            }
            else: {
                this.index = startIndex;
                this.fail("unexpected character while reading value");
            }
        }
    }

    @no_safepoint
    func parse() {
        let byteLength: int = this.byteLength;
        let startIndex: int = 0;
        for (startIndex < byteLength) {
            let current: int = __bytes_get(this.sourceBytes, startIndex);
            if (current != 32 and current != 9 and current != 10 and current != 13) {
                break;
            }
            startIndex = startIndex + 1;
        }
        let value = this.parseValue(0, startIndex);
        let index: int = this.index;
        for (index < byteLength) {
            let current: int = __bytes_get(this.sourceBytes, index);
            if (current != 32 and current != 9 and current != 10 and current != 13) {
                break;
            }
            index = index + 1;
        }
        if (index != byteLength) {
            this.index = index;
            this.fail("trailing content after value");
        }
        this.index = index;
        return value;
    }
}

func __json_hex_character(value: int) -> string {
    return __str_slice("0123456789abcdef", value, value + 1);
}

@no_safepoint
func __json_write_string(parts: Array, value: string) {
    let data: bytes = bytes(value);
    let length: int = __bytes_len(data);
    let segmentStart: int = 0;
    let index: int = 0;
    parts.append("\"");
    for (index < length) {
        let current: int = __bytes_get(data, index);
        if (current == 34 or current == 92 or current < 32) {
            if (index > segmentStart) {
                parts.append(__str_slice(value, segmentStart, index));
            }
            if (current == 34) {
                parts.append("\\\"");
            } else if (current == 92) {
                parts.append("\\\\");
            } else if (current == 8) {
                parts.append("\\b");
            } else if (current == 9) {
                parts.append("\\t");
            } else if (current == 10) {
                parts.append("\\n");
            } else if (current == 12) {
                parts.append("\\f");
            } else if (current == 13) {
                parts.append("\\r");
            } else {
                parts.append("\\u00");
                parts.append(__json_hex_character(int(current / 16)));
                parts.append(__json_hex_character(current % 16));
            }
            index = index + 1;
            segmentStart = index;
        } else if (current >= 128) {
            let width: int = __json_utf8_sequence_length(data, index, length);
            if (width == 0) throw new Exception("Cannot stringify invalid UTF-8 text");
            index = index + width;
        } else {
            index = index + 1;
        }
    }
    if (segmentStart == 0) {
        if (length > 0) parts.append(value);
    } else if (length > segmentStart) {
        parts.append(__str_slice(value, segmentStart, length));
    }
    parts.append("\"");
}

func __json_write_value(parts: Array, value, depth: int) {
    if (depth > 256) throw new Exception("JSON value exceeds maximum nesting depth");
    let actual = value;
    let valueType: string = type(actual);

    when (valueType) {
        "nil": parts.append("null");
        "bool": {
            if (actual) {
                parts.append("true");
            } else {
                parts.append("false");
            }
        }
        "int", "float": parts.append(__builtin_str(actual));
        "string": __json_write_string(parts, actual);
        "Array": {
            parts.append("[");
            let count: int = len(actual);
            for (0..count) [const &index] {
                if (index > 0) parts.append(",");
                __json_write_value(parts, actual[index], depth + 1);
            }
            parts.append("]");
        }
        "dict", "object": {
            parts.append("{");
            let first: bool = true;
            for (actual) [key: item] {
                if (!first) parts.append(",");
                first = false;
                __json_write_string(parts, __builtin_str(key));
                parts.append(":");
                __json_write_value(parts, item, depth + 1);
            }
            parts.append("}");
        }
        else: throw new Exception("Cannot stringify value of type " + valueType);
    }
}

func __json_join_fragments(parts: Array, start: int, end: int) -> string {
    let count: int = end - start;
    if (count <= 0) return "";
    if (count == 1) return parts[start];
    let middle: int = start + int(count / 2);
    return __json_join_fragments(parts, start, middle) +
        __json_join_fragments(parts, middle, end);
}

func __json_stringify(value) -> string {
    let parts: list = [];
    __json_write_value(parts, value, 0);
    using LLVM {
        return string_join(parts, "");
    }
    using VM {
        return __json_join_fragments(parts, 0, parts.length());
    }
}

class JSON {
    using &this;

    let data: dict = {};

    func init(jsonDict) {
        this.data = jsonDict;
    }

    func toString() {
        // The field is read through the receiver rather than getattr: AOT has no
        // native handle for getattr, so emitting this method broke every
        // ahead-of-time build that printed a JSON value.
        let entries: dict = this.data;
        let s: string = "{";

        for (entries) [&key: &value] {
            s = s + str(key) + ": " + str(value) + ", ";
        }
        s = s + "}";
        return s;
    }

    func operator[.] (key) {
        return this.data[key];
    }

    func operator[.=] (key, value) {
        this.data[key] = value;
        return value;
    }

    func operator[[]] (key) {
        return this.data[key];
    }

    func operator[[]=] (key, value) {
        this.data[key] = value;
        return value;
    }

    func copy() {
        return new JSON(this.data);
    }

    // Return native Zeus values: dictionaries, Arrays, strings, numbers, bools or nil.
    func static parse(text: string) {
        let parser: JSONParser = new JSONParser(text);
        return parser.parse();
    }

    func static parseValue(text: string) {
        let parser: JSONParser = new JSONParser(text);
        return parser.parse();
    }

    func static stringify(value) -> string {
        return __json_stringify(value);
    }

    func static encode(value) -> string {
        return __json_stringify(value);
    }
}
