// ==========================================
// Double Math Public Functions
// ==========================================
func sin(x: double) -> double { return __math_sin(x); }
func cos(x: double) -> double { return __math_cos(x); }
func tan(x: double) -> double { return __math_tan(x); }
func asin(x: double) -> double { return __math_asin(x); }
func acos(x: double) -> double { return __math_acos(x); }
func atan(x: double) -> double { return __math_atan(x); }
func atan2(y: double, x: double) -> double { return __math_atan2(y, x); }
func sinh(x: double) -> double { return __math_sinh(x); }
func cosh(x: double) -> double { return __math_cosh(x); }
func tanh(x: double) -> double { return __math_tanh(x); }
func asinh(x: double) -> double { return __math_asinh(x); }
func acosh(x: double) -> double { return __math_acosh(x); }
func atanh(x: double) -> double { return __math_atanh(x); }
func sqrt(x: double) -> double { return __math_sqrt(x); }
func cbrt(x: double) -> double { return __math_cbrt(x); }
func hypot(x: double, y: double) -> double { return __math_hypot(x, y); }
func pow(base: double, exponent: double) -> double { return __math_pow(base, exponent); }
func exp(x: double) -> double { return __math_exp(x); }
func exp2(x: double) -> double { return __math_exp2(x); }
func log(x: double) -> double { return __math_log(x); }
func log2(x: double) -> double { return __math_log2(x); }
func log10(x: double) -> double { return __math_log10(x); }
func floor(x: double) -> double { return __math_floor(x); }
func ceil(x: double) -> double { return __math_ceil(x); }
func round(x: double) -> double { return __math_round(x); }
func trunc(x: double) -> double { return __math_trunc(x); }
func fabs(x: double) -> double { return __math_fabs(x); }
func copysign(magnitude: double, sign: double) -> double { return __math_copysign(magnitude, sign); }
func fmod(x: double, y: double) -> double { return __math_fmod(x, y); }

