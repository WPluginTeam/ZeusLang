func fmodf(x: f32, y: f32) -> f32 { return __math_fmodf(x, y); }

// ==========================================
// High-Level Utility Functions
// ==========================================
func fmin(left: double, right: double) -> double {
    if (left < right) return left;
    return right;
}

func fmax(left: double, right: double) -> double {
    if (left > right) return left;
    return right;
}

func fclamp(value: double, lower: double, upper: double) -> double {
    let minimum = fmin(lower, upper);
    let maximum = fmax(lower, upper);
    if (value < minimum) return minimum;
    if (value > maximum) return maximum;
    return value;
}

func fminf(left: f32, right: f32) -> f32 {
    if (left < right) return left;
    return right;
}

func fmaxf(left: f32, right: f32) -> f32 {
    if (left > right) return left;
    return right;
}

func fclampf(value: f32, lower: f32, upper: f32) -> f32 {
    let minimum = fminf(lower, upper);
    let maximum = fmaxf(lower, upper);
    if (value < minimum) return minimum;
    if (value > maximum) return maximum;
    return value;
}

func lerp(a: double, b: double, t: double) -> double {
    return a + (b - a) * t;
}

func lerpf(a: f32, b: f32, t: f32) -> f32 {
    return a + (b - a) * t;
}

func inv_lerp(a: double, b: double, value: double) -> double {
    if (b == a) return 0.0;
    return (value - a) / (b - a);
}

func inv_lerpf(a: f32, b: f32, value: f32) -> f32 {
    if (b == a) return 0.0;
    return (value - a) / (b - a);
}

func map(value: double, in_min: double, in_max: double, out_min: double, out_max: double) -> double {
    if (in_max == in_min) return out_min;
    return out_min + (out_max - out_min) * ((value - in_min) / (in_max - in_min));
}

func mapf(value: f32, in_min: f32, in_max: f32, out_min: f32, out_max: f32) -> f32 {
    if (in_max == in_min) return out_min;
    return out_min + (out_max - out_min) * ((value - in_min) / (in_max - in_min));
}

func radians(deg: double) -> double {
    return deg * (PI / 180.0);
}

func degrees(rad: double) -> double {
    return rad * (180.0 / PI);
}

func radiansf(deg: f32) -> f32 {
    return deg * (3.1415927 / 180.0);
}

func degreesf(rad: f32) -> f32 {
    return rad * (180.0 / 3.1415927);
}

func isnan(x: double) -> bool {
    return x != x;
}

func isnanf(x: f32) -> bool {
    return x != x;
}
