// Zeus Standard Math Library
// Provides standard IEEE 754 floating-point operations, trigonometric,
// logarithmic, exponential, rounding, and utility functions for double and float.

// ==========================================
// Math Constants
// ==========================================
var const PI: double = 3.14159265358979323846;
var const TAU: double = 6.28318530717958647692;
var const HALF_PI: double = 1.57079632679489661923;
var const E: double = 2.71828182845904523536;
var const SQRT2: double = 1.41421356237309504880;
var const LN2: double = 0.69314718055994530942;
var const LN10: double = 2.30258509299404568402;

// ==========================================
// Integer Math Operations
// ==========================================
func abs(value: int) -> int {
    if (value < 0) return -value;
    return value;
}

func min(left: int, right: int) -> int {
    if (left < right) return left;
    return right;
}

func max(left: int, right: int) -> int {
    if (left > right) return left;
    return right;
}

func clamp(value: int, lower: int, upper: int) -> int {
    let minimum = min(lower, upper);
    let maximum = max(lower, upper);
    if (value < minimum) return minimum;
    if (value > maximum) return maximum;
    return value;
}

func gcd(left: int, right: int) -> int {
    let a = abs(left);
    let b = abs(right);
    for (b != 0) {
        let remainder = a % b;
        a = b;
        b = remainder;
    }
    return a;
}

func lcm(left: int, right: int) -> int {
    if (left == 0 or right == 0) return 0;
    return abs((left / gcd(left, right)) * right);
}

func factorial(n: int) -> int {
    if (n < 0) return 0;
    let result = 1;
    let factor = 2;
    for (factor <= n) {
        result = result * factor;
        factor = factor + 1;
    }
    return result;
}

func fibonacci(n: int) -> int {
    if (n <= 0) return 0;
    if (n == 1) return 1;
    let previous = 0;
    let current = 1;
    let index = 2;
    for (index <= n) {
        let next = previous + current;
        previous = current;
        current = next;
        index = index + 1;
    }
    return current;
}

