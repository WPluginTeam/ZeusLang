using original;

@native("zeus_value_dict_delete")
decl func __dict_delete(value, key);

@native("zeus_value_dict_contains_key_i64")
decl func __dict_has_key(data, key) -> int;

@native("zeus_value_dict_get_normalized")
decl func __dict_get_normalized(data, key);

@native("zeus_value_dict_store_normalized")
decl func __dict_store_normalized(data, key, value);

@native("zeus_value_dict_delete_normalized")
decl func __dict_delete_normalized(data, key);

@native("zeus_value_dict_clone")
decl func __dict_clone(value);

@native("zeus_value_dict_length_i64")
decl func __dict_length_i64(value: dict) -> int;

@native("zeus_value_has_dynamic_member")
decl func __dict_has_to_string(value, method);

func __dict_normalize_string(key: string) -> string {
    return key;
}

func __dict_normalize_key(key) {
    if (type(key) == "string") return key;
    return __builtin_str(key);
}

func __dict_text(value) -> string {
    if (type(value) == "string") return value;
    if (__dict_has_to_string(value, "toString")) {
        let text = value.toString();
        if (type(text) == "string") return text;
        return __builtin_str(text);
    }
    return __builtin_str(value);
}

func __dict_format(data, keys, index: int, count: int) -> string {
    if (index >= count) return "";
    let key = keys[index];
    let value = data[key];
    if (index + 1 >= count) {
        return __dict_text(key) + ": " + __dict_text(value);
    }
    return __dict_text(key) + ": " + __dict_text(value) + ", " +
        __dict_format(data, keys, index + 1, count);
}

class Dict {
    using &this;

    let data = {};

    func init() {
        this.data = {};
    }

    inline func set(key, value) {
        let normalizedKey = __dict_normalize_key(key);
        using LLVM {
            __dict_store_normalized(this.data, normalizedKey, value);
        }
        using VM {
            this.data[normalizedKey] = value;
        }
        return this;
    }

    inline func get(key) {
        let normalizedKey = __dict_normalize_key(key);
        using LLVM {
            return __dict_get_normalized(this.data, normalizedKey);
        }
        using VM {
            return this.data[normalizedKey];
        }
    }

    inline func hasKey(key) {
        let targetKey = __dict_normalize_key(key);
        return __dict_has_key(this.data, targetKey) != 0;
    }

    func keys() {
        let result = [];
        for (this.data) [&entryKey: &entryValue] {
            __array_push(result, entryKey);
        }
        return result;
    }

    func values() {
        let result = [];
        for (this.data) [&entryKey: &entryValue] {
            __array_push(result, entryValue);
        }
        return result;
    }

    func items() {
        let result = [];
        for (this.data) [&entryKey: &entryValue] {
            __array_push(result, [entryKey, entryValue]);
        }
        return result;
    }

    @no_safepoint inline func length() -> int {
        return __dict_length_i64(this.data);
    }

    inline func deleteKey(key) {
        let targetKey = __dict_normalize_key(key);
        using LLVM {
            __dict_delete_normalized(this.data, targetKey);
        }
        using VM {
            __dict_delete(this.data, targetKey);
        }
        return this;
    }

    func clear() {
        this.data = {};
        return this;
    }

    func copy() {
        let result = new Dict();
        result.data = __dict_clone(this.data);
        return result;
    }

    func toString() -> string {
        return "{" + __dict_format(this.data, this.keys(), 0, this.length()) + "}";
    }

    inline func operator[[]=](key, value) {
        let normalizedKey = __dict_normalize_key(key);
        using LLVM {
            __dict_store_normalized(this.data, normalizedKey, value);
        }
        using VM {
            this.data[normalizedKey] = value;
        }
    }

    inline func operator[[]](key) {
        let normalizedKey = __dict_normalize_key(key);
        using LLVM {
            return __dict_get_normalized(this.data, normalizedKey);
        }
        using VM {
            return this.data[normalizedKey];
        }
    }
}

// The built-in dictionary type is globally available as a class value.
class dict {}

// dict 字面量是值类型（不是对象）：`new Dict()` 上的 get 缺键即抛；
// 缺键又要返回默认值时，用自由函数 dict_get，或字面量方法 `d.get(k, fb)`
// （见文件尾的 `impl dict`）。
func dict_get(source, key, fallback = nil) {
    for (source) [&entryKey: &entryValue] {
        if (entryKey == key) return entryValue;
    }
    return fallback;
}

// 写入一个键，容器本身是共享的，所以写进去对持有者是可见的。
//
// 收一个无类型形参是刻意的：局部变量的静态类型来自动态返回值（JSON.parse、
// dict_get）时，直接写 `local[key] = value` 会被 AOT 判成"type 没有匹配的
// 下标 operator"。走形参之后按动态值处理，两个后端行为一致。
func dict_set(source, key, value) {
    source[key] = value;
}

// 字面量的方法分发：`{"a": 1}.get("a")` 走这里。缺键回 fallback，
// 与自由函数 dict_get 同口径（Dict 类的 get 缺键抛，不适合字面量）。
impl dict {
    using &this;

    func get(key, fallback = nil) {
        return dict_get(this, key, fallback);
    }
}
