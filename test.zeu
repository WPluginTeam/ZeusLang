import zeus.static;

@type(T1,T2) class Pair {
    using &this;

    let first: T1? = nil;
    let second: T2? = nil;

    func init(a: T1, b: T2) {
        this.first = a;
        this.second = b;
    }
}

func main() {
    let sa = new StaticArray<Pair<int, string>>(100);
    sa.append(new Pair<int, string>(1, "one"));

    for (0..sa.length()) [i] {
        let item = sa.get(i);
        print("first: ", item.first, ", second: ", item.second);
    }
}
main();
