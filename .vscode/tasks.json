{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 生成最快文件",
            "command": "${env:ComSpec}",
            "args": [
                "/d",
                "/c",
                "call \"F:\\Code\\Env\\VisualStudio2022\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 && cl.exe",
                "/O2",
                "/utf-8",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/bigobj",
                "/MT",
                "/GL",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}",
                "${workspaceFolder}\\ZeusRuntimeLib\\ZeusGCABI.cpp",
                "/link",
                "/LTCG"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的FaST任务。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 生成活动文件",
            "command": "${env:ComSpec}",
            "args": [
                "/d",
                "/c",
                "call \"F:\\Code\\Env\\VisualStudio2022\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 && cl.exe",
                "/Zi",
                "/utf-8",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/bigobj",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}",
                "${workspaceFolder}\\ZeusRuntimeLib\\ZeusGCABI.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}
