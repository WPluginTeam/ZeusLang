func nexora_find_provider_template(templateId: string) {
    let id = templateId.strip();
    for (NEXORA_PROVIDER_TEMPLATES) [entry] {
        if (entry["id"] == id) return entry;
    }
    return nil;
}

func nexora_provider_templates_public() -> Array {
    let output: Array = [];
    for (NEXORA_PROVIDER_TEMPLATES) [entry] {
        output.append({
            "id": entry["id"], "name": entry["name"],
            "base_url": entry["base_url"],
            "model_list_supported": entry["model_list_supported"],
            "model_list_hint": entry["model_list_hint"],
            "docs_url": entry["docs_url"]
        });
    }
    return output;
}
