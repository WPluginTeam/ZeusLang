import zeus.byte;

func nexora_text_is_utf8_continuation(value: int) -> bool {
    return value >= 128 and value <= 191;
}

// Decode UTF-8 with the replacement behavior used by Python's errors="replace".
// Invalid leading bytes are replaced one at a time; a truncated valid prefix
// is replaced as one sequence.
func nexora_text_decode_utf8_replace(raw: bytes) -> string {
    let output = "";
    let index = 0;
    let segmentStart = 0;
    let length = raw.length();

    for (index < length) {
        let lead = raw.get(index);
        let width = 0;
        let secondMin = 128;
        let secondMax = 191;

        if (lead < 128) {
            width = 1;
        } else if (lead >= 194 and lead <= 223) {
            width = 2;
        } else if (lead >= 224 and lead <= 239) {
            width = 3;
            if (lead == 224) secondMin = 160;
            if (lead == 237) secondMax = 159;
        } else if (lead >= 240 and lead <= 244) {
            width = 4;
            if (lead == 240) secondMin = 144;
            if (lead == 244) secondMax = 143;
        }

        if (width == 0) {
            output = output + raw.slice(segmentStart, index).decode("utf-8");
            output = output + "�";
            index = index + 1;
            segmentStart = index;
            continue;
        }

        if (width == 1) {
            index = index + 1;
            continue;
        }

        let valid = true;
        let prefixLength = 1;
        if (index + 1 >= length) {
            valid = false;
        } else {
            let second = raw.get(index + 1);
            if (second < secondMin or second > secondMax) {
                valid = false;
            } else {
                prefixLength = 2;
                for (2..width) [const &offset] {
                    if (index + offset >= length) {
                        valid = false;
                        break;
                    }
                    if (!nexora_text_is_utf8_continuation(raw.get(index + offset))) {
                        valid = false;
                        break;
                    }
                    prefixLength = offset + 1;
                }
            }
        }

        if (valid) {
            index = index + width;
            continue;
        }

        output = output + raw.slice(segmentStart, index).decode("utf-8");
        output = output + "�";
        index = index + prefixLength;
        segmentStart = index;
    }

    return output + raw.slice(segmentStart, length).decode("utf-8");
}

// Zeus string length is byte-based. Count UTF-8 leading bytes so the limit
// matches Python's codepoint slice without splitting a multibyte character.
func nexora_text_truncate_utf8_chars(text: string, maxChars: int) -> string {
    if (maxChars <= 0) return "";
    let raw: bytes = bytes(text);
    let characters = 0;
    for (0..raw.length()) [const &index] {
        let value = raw.get(index);
        if (value < 128 or value >= 192) {
            if (characters >= maxChars) {
                return raw.slice(0, index).decode("utf-8");
            }
            characters = characters + 1;
        }
    }
    return text;
}
