import zeus.mem [&];

func checkedRead(address: int) -> int {
    try {
        return @faddr(address, 8) -> int;
    } catch(&error) {
        return -1;
    }
}

func checkedReadRejectsOutOfBounds(address: int) -> bool {
    try {
        let value = @faddr(address + 16, 1) -> int;
        return false;
    } catch(&error) {
        return true;
    }
}

let address = mem.malloc(16);
@no_safepoint @faddr(address, 1) -> int = 201;
@no_safepoint @faddr(address + 2, 2) -> int = 10234;
@no_safepoint @faddr(address + 4, 4) -> int = 123456789;
@no_safepoint @faddr(address + 8, 8) -> int = 1234567890;

let read1 = @no_safepoint @faddr(address, 1) -> int;
let read2 = @no_safepoint @faddr(address + 2, 2) -> int;
let read4 = @no_safepoint @faddr(address + 4, 4) -> int;
let read8 = @no_safepoint @faddr(address + 8, 8) -> int;
let checked = checkedRead(address + 8);
let checkedRejects = checkedReadRejectsOutOfBounds(address);
mem.free(address);

if (read1 != 201 or read2 != 10234 or read4 != 123456789 or
    read8 != 1234567890 or checked != 1234567890 or !checkedRejects) {
    throw new Exception("faddr checked or unchecked access mismatch");
}
print("UNCHECKED_FADDR_PASS");
