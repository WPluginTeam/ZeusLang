class Item {
    using &this;
    var value: int = 0;
    func init(value: int) { this.value = value; }
}
class Custom {
    using &this;
    var value: int = 0;
    func init(value: int) { this.value = value; }
    func operator[@=]() -> Custom {
        let result = new Custom(this.value + 1);
        return result;
    }
}
class Shared {
    using &this;
    var value: int = 0;
    func init(value: int) { this.value = value; }
    func operator[@=]() -> &Shared { return this; }
}
class Returned {
    using &this;
    var value: int = 0;
    func init(value: int) { this.value = value; }
    func operator[@=]() -> Returned { return this; }
}
func returnShared(value: Shared) -> &Shared {
    return value;
}
let a = new Item(10);
let b = a;
b.value = 20;
if (a.value != 10 or b.value != 20) throw "default copy aliases source";
b = a;
b.value = 30;
if (a.value != 10 or b.value != 30) throw "copy assignment aliases source";
b = b;
if (b.value != 30) throw "self assignment failed";
let custom = new Custom(4);
let copied = custom;
if (custom.value != 4 or copied.value != 5) throw "copy hook not adopted exactly once";
let sharedValue = new Shared(8);
let alias = sharedValue;
alias.value = 9;
if (sharedValue.value != 9) throw "reference hook lost alias";
let replacement = new Shared(11);
alias = replacement;
replacement.value = 12;
if (sharedValue.value != 9 or alias.value != 12) {
    throw "rebinding released another owner's object";
}
let returnedOwner = new Shared(20);
let returnedAlias = returnShared(returnedOwner);
returnedAlias.value = 21;
if (returnedOwner.value != 21) throw "owning reference return lost its object";
returnedOwner = new Shared(22);
if (returnedAlias.value != 21) throw "owning return followed a source rebinding";
let deletedOwner = new Shared(30);
let deletedAlias = deletedOwner;
delete deletedOwner;
var deletedAccessCaught = false;
try {
    let deletedValue = deletedAlias.value;
} catch (&error) {
    deletedAccessCaught = true;
}
if (!deletedAccessCaught) throw "explicit delete did not invalidate shared owners";
let returned = new Returned(7);
let returnedCopy = returned;
returnedCopy.value = 12;
if (returned.value != 7) throw "return this copy recursed or aliased";
print("CLASS_COPY_CORE_PASS");
