// Exercise VM dispatch with the Windows default 1 MB native stack.
var dispatch_passes = 0;
func requireDispatch(name, condition) {
    if (!condition) {
        print("FAIL_VM_DISPATCH", name);
        throw new Exception("VM dispatch regression");
    }
    dispatch_passes = dispatch_passes + 1;
}

// A new operator avoids replacing the built-in bytes indexing/concatenation.
// Every recursive step enters a type implementation through VM dispatch.
impl bytes {
    using &this;
    func operator[-](depth: int) -> int {
        if (depth == 0) return this.get(0);
        if (depth == -1) throw new Exception("deep operator failure");
        if (depth < 0) return this - (depth + 1);
        return this - (depth - 1);
    }
}

func dispatchDefaults(first = b"ab"[0], second = first + 1) {
    return first + second;
}

class DispatchBox {
    using &this;
    var value = 7;
    func operator[+](other) {
        let sentinel = 13;
        return this.value + other + sentinel;
    }
    func operator[[]](key) { return this.value + key; }
    func operator[[]=](key, value) {
        this.value = value + key;
        return -999;
    }
}

func main() {
    let callerSentinel = 31;
    requireDispatch("bytes index", b"ab"[0] == 97);
    requireDispatch("bytes add", (b"ab" + b"cd").decode() == "abcd");
    requireDispatch("bytes slice", b"abcd".slice(1, 3).decode() == "bc");
    requireDispatch("default decode argument", b"ab".decode() == "ab");
    requireDispatch("recursive impl operator", (b"ab" - 256) == 97);
    requireDispatch("caller after recursive operator", callerSentinel == 31);

    var caught = 0;
    try {
        let unexpected = b"ab" - -256;
        caught = -100;
    } catch (&error) {
        if (error.getMessage() == "deep operator failure") caught = 1;
        else caught = -1;
    }
    requireDispatch("deep operator exception", caught == 1);
    requireDispatch("operator after exception", (b"ab" - 256) == 97);
    requireDispatch("caller after exception", callerSentinel == 31);

    let box = new DispatchBox();
    requireDispatch("class operator return", (box + 2) == 22);
    requireDispatch("class index return", box[3] == 10);
    box[2] = 40;
    requireDispatch("class assignment side effect", box.value == 42);
    requireDispatch("class assignment followed by operator", (box + 1) == 56);
    requireDispatch("default expression with operator", dispatchDefaults() == 195);
    requireDispatch("explicit argument and dependent default", dispatchDefaults(5) == 11);
    requireDispatch("explicit arguments", dispatchDefaults(5, 8) == 13);
    requireDispatch("final caller environment", callerSentinel == 31);
    print("VM_DISPATCH_STACK_TEST_PASS", dispatch_passes);
}

main();
