class Child {
    var value = 0;
}

class Record {
    using &this;
    var value = 0;
    var child = nil;

    func init() {
        this.child = new Child();
    }

    func reset() {
        this = new Record();
    }

    func replaceFrom(other) {
        this = other;
    }

    func resetLegacy() {
        @this = new Record();
    }
}

class SelfRecord {
    using &self;
    var count = 0;

    func resetSelf() {
        self = new SelfRecord();
    }

    func resetThis() {
        this = new SelfRecord();
    }
}

let a: Record = new Record();
a.value = 37;
a.child.value = 14;
let b: Record = a;
a.reset();
print(a.value);
print(b.value);
print(b.child.value);

let replacement = new Record();
replacement.value = 91;
replacement.child.value = 73;
a.replaceFrom(replacement);
print(a.value);
print(b.value);
print(b.child.value);

a.resetLegacy();
print(a.value);

let s1: SelfRecord = new SelfRecord();
s1.count = 42;
s1.resetSelf();
print(s1.count);

let s2: SelfRecord = new SelfRecord();
s2.count = 99;
s2.resetThis();
print(s2.count);
