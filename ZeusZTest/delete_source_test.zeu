class DeleteBox {
    using &this;
    var value = 7;

    func get() {
        return this.value;
    }

    func shareSelf() -> &DeleteBox {
        return this;
    }

    func operator[~]() {
        print("DELETE_BOX_DESTROYED");
    }
}

shared class SharedDeleteBox {
    using &this;
    var value = 13;

    func get() {
        return this.value;
    }

    func shareSelf() -> &SharedDeleteBox {
        return this;
    }

    func operator[~]() {
        print("SHARED_DELETE_BOX_DESTROYED");
    }
}

func main() {
    var shared shared_count = 40;
    shared_count = shared_count + 2;
    if (shared_count == 42) {
        print("PASS shared read/write");
    } else {
        throw new Exception("shared write mismatch");
    }

    delete shared_count;
    let sharedScalarRejected = false;
    try {
        print(shared_count);
    } catch (&e) {
        sharedScalarRejected = true;
    }
    if (!sharedScalarRejected) throw new Exception("deleted shared scalar remained readable");
    print("PASS shared delete invalidates slot");

    let ordinary = new DeleteBox();
    let ordinary_copy = ordinary;
    let ordinary_alias = ordinary.shareSelf();
    delete ordinary;
    if (ordinary_copy.get() != 7) throw new Exception("ordinary value copy did not survive source delete");
    print("PASS ordinary value copy survives source delete");
    let ordinaryAliasRejected = false;
    try {
        ordinary_alias.get();
    } catch (&e) {
        ordinaryAliasRejected = true;
    }
    if (!ordinaryAliasRejected) throw new Exception("deleted ordinary object remained usable");
    print("PASS ordinary delete invalidates aliases");
    delete ordinary_alias;

    let shared_object = new SharedDeleteBox();
    let shared_alias = shared_object.shareSelf();
    delete shared_alias;
    let sharedAliasRejected = false;
    try {
        shared_object.get();
    } catch (&e) {
        sharedAliasRejected = true;
    }
    if (!sharedAliasRejected) throw new Exception("deleted shared object remained usable");
    print("PASS shared object delete invalidates aliases");
    delete shared_object;
}

main();
