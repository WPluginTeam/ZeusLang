import zeus.thread [&];
let lock = new thread.Lock();
print("Lock first acquisition:");
print(lock.tryAcquire());
print("Lock second acquisition while held:");
print(lock.tryAcquire());
lock.release();
let recursive = new thread.RLock();
recursive.acquire();
recursive.acquire();
print("RLock recursive tryAcquire:");
print(recursive.tryAcquire());
recursive.release();
recursive.release();
recursive.release();
let semaphore = new thread.Semaphore(1);
print("Semaphore count before:");
print(semaphore.available());
semaphore.acquire();
print("Semaphore count after acquire:");
print(semaphore.available());
semaphore.release();
let event = new thread.Event();
event.set();
print("Event after set:");
print(event.isSet());
event.clear();
print("Event after clear:");
print(event.isSet());
delete lock;
delete recursive;
delete semaphore;
delete event;
