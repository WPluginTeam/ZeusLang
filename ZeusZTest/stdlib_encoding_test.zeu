import zeus.base64;
import zeus.uuid;
import zeus.exception;

func assertEncoding(condition, message: string) {
    if (!condition) throw new Exception("encoding stdlib test failed: " + message);
}

assertEncoding(Base64.encodeText("") == "", "empty base64 string");
assertEncoding(Base64.encodeText("hello") == "aGVsbG8=", "ASCII base64 encoding");
assertEncoding(Base64.decodeText("aGVsbG8=") == "hello", "ASCII base64 decoding");
assertEncoding(Base64.decodeText(Base64.encodeText("Zeus 雪")) == "Zeus 雪",
    "UTF-8 text base64 round trip");
let binary = bytes([0, 1, 2, 127, 128, 255]);
let encodedBinary = Base64.encode(binary);
let decodedBinary = Base64.decode(encodedBinary);
assertEncoding(decodedBinary.length() == binary.length(), "binary base64 length");
for (0..binary.length()) [const &i] {
    assertEncoding(decodedBinary.get(i) == binary.get(i), "binary base64 byte round trip");
}

let generatedUUID = UUID.v4();
assertEncoding(generatedUUID.length() == 36, "UUID v4 width");
assertEncoding(UUID.isValid(generatedUUID), "UUID v4 syntax");
assertEncoding(UUID.isV4(generatedUUID), "UUID version and variant bits");
assertEncoding(UUID.normalize("A0B1C2D3-E4F5-4678-89AB-CDEF01234567") ==
    "a0b1c2d3-e4f5-4678-89ab-cdef01234567", "UUID normalization");
assertEncoding(!UUID.isValid("not-a-uuid"), "invalid UUID rejection");
assertEncoding(!UUID.isV4("a0b1c2d3-e4f5-1678-89ab-cdef01234567"),
    "non-v4 rejection");

print("PASS base64 and UUID standard libraries");
